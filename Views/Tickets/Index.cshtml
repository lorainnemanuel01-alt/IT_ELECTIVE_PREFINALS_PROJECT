@model IEnumerable<Ticket>
@{ ViewData["Title"] = "Tickets"; }
<h1>Tickets</h1><form method="get" class="card"><label>Status <select name="status"><option value="">All</option>@foreach(string s in ViewBag.Statuses){<option value="@s">@s</option>}</select></label> <label>Priority <select name="priority"><option value="">All</option>@foreach(string p in ViewBag.Priorities){<option value="@p">@p</option>}</select></label> <button type="submit">Filter</button></form><table><thead><tr><th>ID</th><th>Subject</th><th>Customer</th><th>Category</th><th>Priority</th><th>Status</th><th>Created</th><th>Due</th></tr></thead><tbody>@foreach(var t in Model){<tr><td><a asp-action="Details" asp-route-id="@t.Id">@t.Id</a></td><td>@t.Subject</td><td>@t.Customer.CompanyName</td><td>@t.Category.Name</td><td>@t.Priority.Name</td><td>@t.Status.Name</td><td>@t.CreatedAt</td><td>@(t.DueAt?.ToString() ?? "—")</td></tr>}</tbody></table>
