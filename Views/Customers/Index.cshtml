@model IEnumerable<Customer>
@{ ViewData["Title"] = "Customers"; }
<h1>Customers</h1><table><thead><tr><th>Company</th><th>Contact Name</th><th>Email</th><th>Phone</th><th>Active</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.CompanyName</td><td>@c.ContactName</td><td>@c.Email</td><td>@c.Phone</td><td>@c.IsActive</td></tr>}</tbody></table>
